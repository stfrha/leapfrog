<UserControl x:Class="LeapfrogEditor.PlanetSurfacePropEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LeapfrogEditor"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="200">
   <StackPanel Margin="2">
      <local:HeadlineControl Headline="Planet Surface Properties" />
      <TextBlock FontSize="10" TextWrapping="Wrap" Margin="0,2,0,4"
         Text="The planet's surface, unrolled: x along the ground (61.1 per degree), y the height (0 = the ground, negative above it). The ruler shows degrees; drag a site's flag on it to move the site (Shift: snap to the ruler's ticks)." />
      <local:TexturePickerEditorControl Headline="Ground Texture" NoneValue="none" MyValue="{Binding Texture, Mode=TwoWay}"
         ToolTip="The planet's texture; none = the orbit scene's" />
      <local:DoubleEditorControl Headline="Tile Width" MyValue="{Binding TextureMeterWidth, Mode=TwoWay}"
         ToolTip="The width of one tile of the ground texture, in surface units (61.1 per degree); 0 = the texture's width in pixels" />
      <local:DoubleEditorControl Headline="Tile Height" MyValue="{Binding TextureMeterHeight, Mode=TwoWay}"
         ToolTip="The height of one tile; 0 = in proportion to the width" />
      <local:HeadlineControl Headline="Landing Sites (game order)" />
      <ItemsControl ItemsSource="{Binding Sites}">
         <ItemsControl.ItemTemplate>
            <DataTemplate>
               <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="3" Margin="0,2" Padding="2">
                  <StackPanel>
                     <local:StringEditorControl Headline="Name" MyValue="{Binding Name, Mode=TwoWay}"
                        ToolTip="For the scripts (c_lastReentry)" />
                     <local:StringEditorControl Headline="Label" MyValue="{Binding Label, Mode=TwoWay}"
                        ToolTip="Shown under the site's solution marker in orbit; empty = the name" />
                     <local:DoubleEditorControl Headline="Angle (degrees)" MyValue="{Binding Angle, Mode=TwoWay}"
                        ToolTip="Along the surface, growing to the right, as on the ruler" />
                     <local:TexturePickerEditorControl Headline="Marker" NoneValue="none" MyValue="{Binding Texture, Mode=TwoWay}"
                        ToolTip="The site's marker on the ground (100 x 30); none when the surface's art shows the site" />
                     <local:StringEditorControl Headline="Landing Scene" MyValue="{Binding Scene, Mode=TwoWay}"
                        ToolTip="The landing scene the site leads to, e.g. landing_scene.xml" />
                     <Button Content="Remove Site" FontSize="10" Padding="6,0" Margin="0,2,0,0" HorizontalAlignment="Right"
                        Command="{Binding Remove}" />
                  </StackPanel>
               </Border>
            </DataTemplate>
         </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Content="Add Site" FontSize="10" Padding="6,0" Margin="0,2" HorizontalAlignment="Left"
         Command="{Binding AddSiteCommand}"
         ToolTip="A new site at the angle in the middle of the view" />
   </StackPanel>
</UserControl>
