<UserControl x:Class="LeapfrogEditor.OrbitScenePropEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LeapfrogEditor"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="200">
   <StackPanel Margin="2">
      <local:HeadlineControl Headline="Orbit Scene Properties" />
      <local:StringEditorControl Headline="Surface File" MyValue="{Binding SurfaceFile, Mode=TwoWay}"
         ToolTip="The planet's surface (behaviour planetSurface): its art and landing sites" />
      <local:TexturePickerEditorControl Headline="Planet Texture" MyValue="{Binding Texture, Mode=TwoWay}"
         ToolTip="Used when the surface file gives none" />
      <local:StringEditorControl Headline="Space Scene" MyValue="{Binding SpaceSceneFile, Mode=TwoWay}" />
      <local:StringEditorControl Headline="Space Background" MyValue="{Binding SpaceSceneBackground, Mode=TwoWay}" />
   </StackPanel>
</UserControl>
