<UserControl x:Class="LeapfrogEditor.CompoundObjectPropEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LeapfrogEditor"
             x:Name="root"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
   <UserControl.Resources>
      <local:BoolToVisibilityValueConverter x:Key="BoolToVisibilityValueConverter" />
   </UserControl.Resources>
   <DockPanel Margin="2">
      <Border CornerRadius="5" BorderBrush="DarkGray" BorderThickness="2">
         <StackPanel Margin="2">
            <local:HeadlineControl Headline="{Binding Headline, ElementName=root}" />
            <local:StringEditorControl Headline="Name" MyValue="{Binding Name, Mode=TwoWay}" />
            <local:BoolEditorControl Headline="Needs Group Index" MyValue="{Binding NeedsGroupIndex, Mode=TwoWay}" />
            <local:StringListSelectionEditorControl 
               Headline="Behaviour" 
               Strings="{Binding Behaviours}"
               SelectionIndex="{Binding SelectedBehaviourIndex, Mode=TwoWay}" />
            <local:BoolEditorControl 
               Headline="Active" 
               MyValue="{Binding Behaviour.Active, Mode=TwoWay}"
               Visibility="{Binding Behaviour.HasActiveFlag, Converter={StaticResource BoolToVisibilityValueConverter}}"
               ToolTip="Landing pads and launch sites: an inactive one can be landed on, but nothing happens there. Lua can switch it (property 2)." />
            <local:StringListSelectionEditorControl 
               Headline="Fuel" 
               Strings="{Binding Behaviour.FuelServices}"
               SelectionIndex="{Binding Behaviour.SelectedFuelIndex, Mode=TwoWay}"
               Visibility="{Binding Behaviour.HasFuelSettings, Converter={StaticResource BoolToVisibilityValueConverter}}"
               ToolTip="none: no fuel here. sell: fuel for credits (a fuel station). free: fuel at no cost from a limited supply. Fuel flows only while the pad is active." />
            <local:DoubleEditorControl 
               Headline="Fuel per Second" 
               MyValue="{Binding Behaviour.FuelRate, Mode=TwoWay}"
               Visibility="{Binding Behaviour.ShowsFuelRate, Converter={StaticResource BoolToVisibilityValueConverter}}"
               ToolTip="How fast fuel flows in while standing on the pad (the tank holds 100)" />
            <local:DoubleEditorControl 
               Headline="Credits per Fuel" 
               MyValue="{Binding Behaviour.FuelPrice, Mode=TwoWay}"
               Visibility="{Binding Behaviour.ShowsFuelPrice, Converter={StaticResource BoolToVisibilityValueConverter}}"
               ToolTip="Price of one unit of fuel (a full tank is 100 units)" />
            <local:DoubleEditorControl 
               Headline="Fuel Supply" 
               MyValue="{Binding Behaviour.FuelSupply, Mode=TwoWay}"
               Visibility="{Binding Behaviour.ShowsFuelSupply, Converter={StaticResource BoolToVisibilityValueConverter}}"
               ToolTip="How much free fuel the pad has; -1 = no limit. Lua can read and refill it (property 3)." />
            <ContentControl 
               DataContext="{Binding Behaviour.BehaviourProperties}"
               Content="{Binding}">
               <ContentControl.Resources>
                  <DataTemplate DataType="{x:Type local:ScenePropertiesViewModel}">
                     <local:ScenePropEditor />
                  </DataTemplate>
                  <DataTemplate DataType="{x:Type local:SteerableObjectPropertiesViewModel}">
                     <local:SteerableBehaviourPropEditor />
                  </DataTemplate>
                  <DataTemplate DataType="{x:Type local:BreakableObjectPropertiesViewModel}">
                     <local:BreakabkeBehaviourPropEditor />
                  </DataTemplate>
                  <DataTemplate DataType="{x:Type local:ExplosiveObjectPropertiesViewModel}">
                     <local:ExplosiveBehaviourPropEditor />
                  </DataTemplate>
                  <DataTemplate DataType="{x:Type local:MagneticMinePropertiesViewModel}">
                     <local:MagneticMineBehaviourPropEditor />
                  </DataTemplate>
                  <DataTemplate DataType="{x:Type local:PickupObjectPropertiesViewModel}">
                     <local:PickupBehaviourPropEditor />
                  </DataTemplate>
                  <DataTemplate DataType="{x:Type local:StripperPropertiesViewModel}">
                     <local:StripperBehaviourPropEditor />
                  </DataTemplate>
                  <DataTemplate DataType="{x:Type local:SwarmPropertiesViewModel}">
                     <local:SwarmBehaviourPropEditor />
                  </DataTemplate>
                  <DataTemplate DataType="{x:Type local:PlanetSurfacePropertiesViewModel}">
                     <local:PlanetSurfacePropEditor />
                  </DataTemplate>
                  <DataTemplate DataType="{x:Type local:OrbitScenePropertiesViewModel}">
                     <local:OrbitScenePropEditor />
                  </DataTemplate>
                  <DataTemplate x:Key="He1" >
                     <Label Content="Undef Properties" />
                  </DataTemplate>
               </ContentControl.Resources>
            </ContentControl>
         </StackPanel>
      </Border>
   </DockPanel>
</UserControl>
