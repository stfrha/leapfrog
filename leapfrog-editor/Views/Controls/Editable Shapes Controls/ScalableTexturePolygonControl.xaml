<UserControl x:Class="LeapfrogEditor.ScalableTexturePolygonControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LeapfrogEditor"
             xmlns:ZoomAndPan="clr-namespace:ZoomAndPan;assembly=ZoomAndPan"
             x:Name="root"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
   <UserControl.Resources>
      <local:TexturePathValueConverter x:Key="TexturePathValueConverter" />
      <local:TextureRectMultiValueConverter x:Key="TextureRectMultiValueConverter" />
      <local:EdgeFadeMaskConverter x:Key="EdgeFadeMaskConverter" />
   </UserControl.Resources>
   <Grid>
      <Polygon 
               x:Name="stpvm"
               StrokeThickness="0"
               Points="{Binding AbsPoints}"
				   MouseDown="Shape_MouseDown"
				   MouseUp="Shape_MouseUp"
				   MouseMove="Shape_MouseMove">
         <Polygon.Fill>
            <ImageBrush
                     ViewportUnits="Absolute"
                     TileMode="Tile"
                     Stretch="Uniform"
                     AlignmentX="Center"
                     AlignmentY="Center" 
                     ImageSource="{Binding TextureImage}" >
               <ImageBrush.Viewport>
                  <MultiBinding Converter="{StaticResource TextureRectMultiValueConverter}" >
                     <Binding Path="TextureOffsetX" />
                     <Binding Path="TextureOffsetY" />
                     <Binding Path="TextureWidth" />
                     <Binding Path="TextureHeight" />
                  </MultiBinding>
               </ImageBrush.Viewport>
            </ImageBrush>
         </Polygon.Fill>
         <!-- Edge fade, in the polygon's own coordinates (as the game) -->
         <Polygon.OpacityMask>
            <MultiBinding Converter="{StaticResource EdgeFadeMaskConverter}">
               <Binding Path="AbsPoints" />
               <Binding Path="EdgeFadeWidth" />
               <Binding Path="EdgeFadeAmount" />
               <Binding Path="EdgeFadeSides" />
            </MultiBinding>
         </Polygon.OpacityMask>
         <Polygon.RenderTransform>
            <TransformGroup>
               <RotateTransform x:Name="d1"
                        Angle="{Binding Angle}"
                        CenterX="0"
                        CenterY="0"
                     />
            </TransformGroup>
         </Polygon.RenderTransform>
      </Polygon>
   </Grid>
</UserControl>
