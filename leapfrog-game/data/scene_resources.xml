<?xml version="1.0" encoding="utf-8"?>
<!-- Which resource files each scene loads in addition to res.xml
     (one or more, separated by spaces, searched in that order).
     They are loaded when the scene starts; files the next scene
     doesn't list are freed. Scenes not listed use res.xml only. -->
<sceneResources>
	<scene file="landing_scene.xml" resources="res_mining.xml"/>
	<scene file="home_scene.xml" resources="res_mining.xml"/>
	<scene file="orbit_scene.xml" resources="res_mining.xml"/>
	<scene file="deep_space_scene.xml" resources="res_space.xml"/>
</sceneResources>
