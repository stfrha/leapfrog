<?xml version="1.0" encoding="utf-8"?>
<!--
  A swarm of strippers coming from all sides (behaviour "swarm", see
  src/swarm.h). Each one appears at a random spot on a random side, in the
  soft boundary haze 30 outside the scene edge, at least 200 from the
  Leapfrog, and flies in by itself.

  It starts gently (one every 5 s, at most 2 alive) and over 3 minutes
  grows to two a second, up to 25 alive: easy to fight off at first,
  impossible in the end.

  Lua: lua/swarm.lua starts it and stops it when the Leapfrog has been
  stripped:
     swarm.start("swarm", "stripper_swarm.xml", function(name) ... end)
  or by hand: c_addPositionedChildObject("stripper_swarm.xml", "swarm", 0, 0)
  and the properties 0 active, 1 rate, 2 maxAlive, 3 alive, 4 spawned,
  5 recall.
-->
<compoundObject>
  <behaviour
    type="swarm">
    <swarmProperties
      spawn="stripper.xml"
      active="true"
      startRate="0.2"
      rate="2"
      startMaxAlive="2"
      maxAlive="25"
      rampTime="180"
      initialSpawn="1"
      spawnInset="30"
      minDistance="200" />
  </behaviour>
</compoundObject>
