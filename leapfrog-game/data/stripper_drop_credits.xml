<?xml version="1.0" encoding="utf-8"?>
<!--
  What a Stripper drops when it is shot down carrying credits. The Stripper
  sets pickupType and amount to exactly what it took.
-->
<compoundObject
  needsGroupIndex="true">
  <behaviour
    type="pickupObject">
    <pickupObjectProperties
      pickupType="resourceCoin"
      amountType="fix"
      amount="0" />
  </behaviour>
  <dynamicCircle
    name="lootBody"
    texture="coin_power_up"
    posX="0"
    posY="0"
    angle="0"
    zLevel="160"
    collisionEntity="pickup"
    collisionCategory="1"
    collisionMask="65533"
    radius="5"
    density="1"
    friction="0" />
</compoundObject>
