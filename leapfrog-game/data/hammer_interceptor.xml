<?xml version="1.0" encoding="utf-8"?>
<!--
  Hammer interceptor: the military's small, fast fighter, a double-bitted
  axe seen from above (models/sprites/hammer_interceptor.py). Compared with
  the hammer (deep_space_scene.xml, hammer1): about a sixth of its mass,
  quicker to accelerate, faster and turning faster, but half the armour
  (the third bullet hit destroys it) and a weaker, shorter-ranged gun.
  Front to the left in the texture; the body is turned 180 like the hammer's.
  Place it with <childObject name="..." file="hammer_interceptor.xml" posX
  posY/> or c_addPositionedChildObject.
-->
<compoundObject
  needsGroupIndex="true"
  resources="res_space.xml">
  <dynamicCircle
    name="mainBody"
    texture="hammer_interceptor"
    posX="0"
    posY="0"
    angle="180"
    zLevel="160"
    collisionEntity="steerableObject"
    collisionCategory="1"
    collisionMask="65533"
    radius="6.5"
    density="2"
    friction="1" />
  <behaviour
    type="steerableObject">
    <steerableObjectProperties
      steeringState="wanderHunt"
      targetBody="leapfrog1.lfMainBody"
      bodyToBoosterAngle="180"
      seekTargetX="100"
      seekTargetY="100"
      maxBoosterForce="320"
      maxSpeed="55"
      degPerSecMaxRotateSpeed="75"
      linearDamping="0.5"
      armour="50" />
  </behaviour>
  <system
    name="boosterFlame"
    type="flameEmitter">
    <flameEmitterProperties
      body="mainBody"
      systemOriginX="6.3"
      systemOriginY="0"
      angle="0"
      emitterWidth="2.5"
      lifeTime="350"
      impulseMagnitude="70"
      radius="6" />
  </system>
  <system
    name="gun"
    type="gun">
    <gunProperties
      body="mainBody"
      systemOriginX="-5.6"
      systemOriginY="0"
      angle="-180"
      fireRate="3"
      lifeTime="1200"
      impulseMagnitude="6000"
      bouncy="false" />
  </system>
  <system
    name="shield"
    type="shield">
    <shieldProperties
      body="mainBody"
      systemOriginX="0"
      systemOriginY="0"
      radius="16"
      zLevel="147" />
  </system>
</compoundObject>
